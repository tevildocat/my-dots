! X colors.
! Generated by 'wal'
*foreground:        #e8e5de
*background:        #121418
*.foreground:       #e8e5de
*.background:       #121418
emacs*foreground:   #e8e5de
emacs*background:   #121418
URxvt*foreground:   #e8e5de
XTerm*foreground:   #e8e5de
UXTerm*foreground:  #e8e5de
URxvt*background:   [100]#121418
XTerm*background:   #121418
UXTerm*background:  #121418
URxvt*cursorColor:  #e8e5de
XTerm*cursorColor:  #e8e5de
UXTerm*cursorColor: #e8e5de
URxvt*borderColor:  [100]#121418

! Colors 0-15.
*.color0: #121418
*color0:  #121418
*.color1: #6A736F
*color1:  #6A736F
*.color2: #798377
*color2:  #798377
*.color3: #848A7C
*color3:  #848A7C
*.color4: #7B8282
*color4:  #7B8282
*.color5: #9FA295
*color5:  #9FA295
*.color6: #CAC5B4
*color6:  #CAC5B4
*.color7: #e8e5de
*color7:  #e8e5de
*.color8: #a2a09b
*color8:  #a2a09b
*.color9: #6A736F
*color9:  #6A736F
*.color10: #798377
*color10:  #798377
*.color11: #848A7C
*color11:  #848A7C
*.color12: #7B8282
*color12:  #7B8282
*.color13: #9FA295
*color13:  #9FA295
*.color14: #CAC5B4
*color14:  #CAC5B4
*.color15: #e8e5de
*color15:  #e8e5de

! Black color that will not be affected by bold highlighting.
*.color66: #121418
*color66:  #121418

! Xclock colors.
XClock*foreground: #e8e5de
XClock*background: #121418
XClock*majorColor:  rgba:e8/e5/de/ff
XClock*minorColor:  rgba:e8/e5/de/ff
XClock*hourColor:   rgba:e8/e5/de/ff
XClock*minuteColor: rgba:e8/e5/de/ff
XClock*secondColor: rgba:e8/e5/de/ff

! Set depth to make transparency work.
URxvt*depth: 32
