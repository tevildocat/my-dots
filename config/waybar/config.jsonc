{
	"layer": "top",
	"margin-top": 4,
	"margin-bottom": 4,
	"margin-left": 4,
    "margin-right": 4,
    "spacing": 5,
    // Load Modules
    "include": [
        "~/.config/waybar/modules.json"
    ],

    "modules-left": [
     	"hyprland/window"
    ],

    "modules-center": [
        "hyprland/workspaces"
    ],

    "modules-right": [
        "hyprland/language",
    	"pulseaudio",
    	"tray",
    	"clock"
    ]
}