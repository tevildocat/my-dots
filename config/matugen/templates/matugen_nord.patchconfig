# This patchconfig was used to build this Kvantum Theme using https://github.com/HimDek/Utterly-Round-Plasma-Style/tree/master/kvantum/Utterly-Round-Transparent-Kvantum-Template

#colors
background={{colors.background.default.hex}}
foreground={{colors.on_surface.default.hex}}
accent={{colors.surface_container_low.default.hex}}
negative={{colors.error.default.hex}}
button={{colors.tertiary_fixed.default.hex}}
inactive={{colors.on_surface_variant.default.hex}}
link={{colors.secondary.default.hex}}
visitedlink={{colors.on_secondary_container.default.hex}}

#details
name=Nord
author="Himprakash Deka"
comment="A dark nordic Kvantum theme with transparency, blur and round borders for UI elements"
